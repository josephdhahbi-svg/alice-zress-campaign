        {
          "id": 1,
          "tag": "Heroic",
          "text": "Help Maris evacuate the guests before checking the cellar.",
          "effects": {
            "approval": 3,
            "flags": [
              "guests_safe"
            ],
            "quest": "Q-TAVERN-13"
          }
        },
        {
          "id": 2,
          "tag": "Comedy",
          "text": "Ask whether planar disasters are included in the room rate.",
          "effects": {
            "approval": 1,
            "flags": [
              "maris_laughs"
            ]
          }
        },
        {
          "id": 3,
          "tag": "Flirt",
